{
	// 这里是配置每个页面的显示路径 和style（说明见下面，相当于可以配置样式的vuerouter
	// condition是给小程序开发者工具调试使用的页面切换功能
	"condition": {
		"current": 0,
		"list": [{
			"name": "登录",
			"path": "pages/login/login",
			"query": ""
		}, {
			"name": "AI功能列表",
			"path": "pages/assistantList/assistantList",
			"query": ""
		}, {
			"name": "对话页面",
			"path": "pages/talk/talk",
			"query": ""
		}]
	},
	// 注意，任何新页面必须在pages项里进行注册
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/conversationHistory/conversationHistory",
			// 对应页面的局部配置，会覆盖下面的globalStyle
			"style": {
				"navigationBarTitleText": "历史对话"
			}
		},
		{
			"path": "pages/assistantList/assistantList",
			"style": {
				"navigationBarTitleText": "AI助理列表"
			}
		}, {
			"path": "pages/person/person",
			"style": {
				"navigationBarTitleText": "个人信息"
				// "enablePullDownRefresh": false
			}

		}, {
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": ""
				// "enablePullDownRefresh": false
			}

		}, {
			"path": "pages/talk/talk",
			"style": {
				"navigationBarTitleText": ""
			}
		}
	],
	"globalStyle": {
		// 颜色名只支持 H5，wx只能十六进制，去看wx小程序文档
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#ffffff",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar": {
		"color": "#bfbfbf", // 未选中时文字颜色
		"selectedColor": "#78c5c0", // 选中时文字颜色 $uni-color-primary: #78c5c0
		"backgroundColor": "#fff", // 背景颜色
		"borderStyle": "white", // 顶部边框颜色
		"fontSize": "10px",
		// list is necessary in tabbar 
		"list": [{
				"pagePath": "pages/conversationHistory/conversationHistory",
				// text can be any words you want
				"text": "历史对话",
				"iconPath": "static/Talk.png",
				"selectedIconPath": "static/Talk-Checked.png"
				// "iconWidth": "80rpx", // 调整图标宽度
				// "iconHeight": "80rpx" // 调整图标高度
			},
			{
				"pagePath": "pages/assistantList/assistantList",
				"text": "AI功能列表",
				"iconPath": "static/Folder.png",
				"selectedIconPath": "static/Folder-Checked.png"
			},
			{
				"pagePath": "pages/person/person",
				"text": "个人信息",
				"iconPath": "static/Person.png",
				"selectedIconPath": "static/Person-Checked.png"
			}
		]
	},
	"subPackages": [{
		"root": "subpkg_task",
		"pages": [{
			"path": "rootpkg/rootpkg",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false
			}

		}]
	}],
	"uniIdRouter": {}
}